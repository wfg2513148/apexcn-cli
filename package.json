{
  "name": "apexcn-cli",
  "version": "1.0.10",
  "type": "module",
  "bin": {
    "apexcn": "./dist/index.js"
  },
  "files": [
    "agent-skill/",
    "dist/",
    "docs/",
    "eval/qualification/tasks.v2.jsonl",
    "qualification/ga/README.md",
    "qualification/ga/fixtures-v1.json",
    "qualification/ga/harness-manifest-v1.json",
    "qualification/ga/public-surface-v2.json",
    "qualification/ga/qualification-contract-v2.json",
    "qualification/ga/support-matrix-v2.json",
    "qualification/ga/task-plan-v1.jsonl",
    "scripts/ga-qualification-recorder.mjs",
    "scripts/ga-qualification-score.mjs",
    "scripts/install-agent.ps1",
    "scripts/install-agent.sh",
    "scripts/lifecycle-agent.ps1",
    "scripts/lifecycle-agent.sh",
    "scripts/verify-release-supply-chain.mjs",
    "README.md"
  ],
  "scripts": {
    "baseline": "node scripts/baseline-report.mjs",
    "build": "tsc -p tsconfig.json",
    "check:ga-readiness": "node scripts/check-ga-readiness.mjs",
    "check:ga-harness": "node scripts/generate-ga-qualification-harness.mjs --check",
    "check:release": "node scripts/check-release-version.mjs && node scripts/check-release-artifacts.mjs && node scripts/check-workflows.mjs && node scripts/check-source-layout.mjs && node scripts/check-roadmap.mjs && node scripts/check-ga-readiness.mjs",
    "check:roadmap": "node scripts/check-roadmap.mjs",
    "check:source-layout": "node scripts/check-source-layout.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "context:compact": "node scripts/compact-iteration-context.mjs",
    "eval:rag": "node scripts/eval-rag.mjs --report",
    "eval:agent-rag": "node scripts/eval-agent-rag.mjs",
    "eval:retrieval": "node scripts/eval-retrieval.mjs --report",
    "score:ga-qualification": "node scripts/ga-qualification-score.mjs",
    "soak:readonly": "node scripts/soak-readonly.mjs",
    "test": "vitest run",
    "test:e2e:readonly": "bash scripts/e2e-readonly.sh"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "bundledDependencies": [
    "commander"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "bundleDependencies": [
    "commander"
  ]
}
