  "requiredStages": [
    "install-source",
    "upgrade-to-candidate",
    "failed-upgrade-auto-recovery",
    "rollback-to-source",
    "reupgrade-and-uninstall"
  ],
  "requiredAssertions": [
    "candidate version and package checksum match the frozen scope contract",
    "authentication configuration is preserved through every stage",
    "invalid candidate checksum fails before replacement",
    "failed upgrade restores the exact source version",
    "rollback restores the exact source version",
    "uninstall removes only the isolated CLI installation and launcher",
    "no production community write request occurs",
    "first-attempt stdout, stderr, exit code, timestamps, and artifact hashes are retained"
  ],
  "environmentContract": {
    "isolatedInstallRootRequired": true,
    "isolatedLauncherRequired": true,
    "isolatedConfigRequired": true,
    "realUserHomeMutationAllowed": false,
    "productionWriteAllowed": false,
    "cleanupScope": "Only directories and launchers created under the run-specific isolation root.",
    "failureInjection": [
      "missing candidate package",
      "candidate checksum mismatch",
      "truncated candidate archive",
      "absolute archive path",
      "parent-directory archive path"
    ]
  },
